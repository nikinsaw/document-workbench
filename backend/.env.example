# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Storage
DB_PATH=./data/workbench.db
UPLOAD_DIR=./uploads

# Upload limits
MAX_FILE_SIZE_BYTES=15728640
MAX_FILES_PER_UPLOAD=10
MAX_PROMPT_LENGTH=2000

# LLM
# Leave ANTHROPIC_API_KEY blank to automatically fall back to the built-in
# MockLlmClient (useful for local dev / running tests without API access).
ANTHROPIC_API_KEY=apikey_01Rj2N8SVvo6BePZj99NhmiT
LLM_MODEL=claude-sonnet-4-6
USE_MOCK_LLM=false

# Roughly how many characters of a single document's extracted text to send
# to the LLM before truncating (~4 chars/token).
MAX_CHARS_PER_DOCUMENT=24000
